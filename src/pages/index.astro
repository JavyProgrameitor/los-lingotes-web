---
import "../styles/global.css";

import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import CartelesMoulinRouge from "../components/CartelesMoulinRouge.astro";
import SectionGaleria from "../components/SectionGaleria.astro";
import Footer from "../components/Footer.astro";

// URL principal de la web
const SITE_URL = "https://loslingotes.es";

// Imagen institucional del aniversario
const OG_IMAGE = `${SITE_URL}/og.jpg`;

// Imagen principal del Carnaval 2027
const CARNAVAL_IMAGE = `${SITE_URL}/moulin-rouge-2027.png`;

// Datos estructurados de la comparsa
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Comparsa Los Lingotes",
  url: SITE_URL,
  logo: OG_IMAGE,
  image: OG_IMAGE,
  description:
    "Comparsa de Carnaval Los Lingotes de Talavera la Real (Badajoz). Actuaciones, historia y carnaval.",
  sameAs: [
    "https://www.facebook.com/loslingotes",
    "https://www.instagram.com/comparsalingotes",
    "https://www.tiktok.com/@comparsaloslingotes",
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Talavera la Real",
    addressRegion: "Extremadura",
    addressCountry: "ES",
  },
});

// Datos estructurados de la portada
const webPageJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Comparsa Los Lingotes | Moulin Rouge 2027",
  url: `${SITE_URL}/`,
  description:
    "Descubre el Carnaval 2027 de la Comparsa Los Lingotes, inspirado en el Moulin Rouge.",

  // Imagen representativa de la portada
  image: CARNAVAL_IMAGE,

  primaryImageOfPage: {
    "@type": "ImageObject",
    url: CARNAVAL_IMAGE,
    contentUrl: CARNAVAL_IMAGE,
    width: 713,
    height: 960,
    caption: "Moulin Rouge 2027 - Comparsa Los Lingotes",
  },
});
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Título -->
    <title>Comparsa Los Lingotes | Moulin Rouge 2027</title>

    <!-- Descripción SEO -->
    <meta
      name="description"
      content="Comparsa Los Lingotes de Talavera la Real. Descubre nuestro Carnaval 2027 inspirado en el Moulin Rouge, nuestra galería y nuestra historia."
    />

    <!-- URL canónica -->
    <link rel="canonical" href={`${SITE_URL}/`} />

    <!-- Iconos -->
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />

    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />

    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta name="theme-color" content="#120609" />

    <!-- Open Graph: imagen institucional -->
    <meta property="og:type" content="website" />

    <meta property="og:site_name" content="Comparsa Los Lingotes" />

    <meta
      property="og:title"
      content="Comparsa Los Lingotes | Moulin Rouge 2027"
    />

    <meta
      property="og:description"
      content="Los Lingotes presentan su Carnaval 2027 inspirado en el universo del Moulin Rouge y la Belle Époque."
    />

    <meta property="og:url" content={`${SITE_URL}/`} />

    <meta property="og:image" content={OG_IMAGE} />

    <meta property="og:image:secure_url" content={OG_IMAGE} />

    <meta property="og:image:type" content="image/jpeg" />

    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta
      property="og:image:alt"
      content="Imagen institucional de la Comparsa Los Lingotes"
    />

    <meta property="og:locale" content="es_ES" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />

    <meta
      name="twitter:title"
      content="Comparsa Los Lingotes | Moulin Rouge 2027"
    />

    <meta
      name="twitter:description"
      content="Descubre el Carnaval 2027 de la Comparsa Los Lingotes, inspirado en el Moulin Rouge."
    />

    <meta name="twitter:image" content={OG_IMAGE} />

    <!-- Datos estructurados de la comparsa -->
    <script type="application/ld+json" is:inline set:html={jsonLd} />

    <!-- Datos estructurados de la portada -->
    <script type="application/ld+json" is:inline set:html={webPageJsonLd} />

    <!-- Verificación Bing -->
    <meta name="msvalidate.01" content="2B7261B181FB3A3472FF5A58A9D5AB6D" />

    <!-- Indexación y vistas previas de imágenes -->
    <meta name="robots" content="index,follow,max-image-preview:large" />

    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Modo oscuro por defecto en cada carga -->
    <script is:inline>
      (() => {
        document.documentElement.classList.add("dark");
        localStorage.setItem("theme", "dark");
      })();
    </script>
  </head>

  <body
    class="bg-[#f5e9d7] text-[#542a2b] transition-colors duration-500 dark:bg-[#120609] dark:text-[#f5dfb5]"
  >
    <!-- CABECERA -->
    <Header />

    <!-- PORTADA ANIMADA MOULIN ROUGE -->
    <Hero />

    <!-- PRESENTACIÓN CARNAVAL 2027 -->
    <section
      id="carnaval"
      class="relative overflow-hidden bg-[#f5e9d7] px-5 py-20 text-[#542a2b] transition-colors duration-500 dark:bg-[#120609] dark:text-[#f5dfb5] sm:py-28"
    >
      <!-- Iluminación ambiental -->
      <div
        class="pointer-events-none absolute left-1/2 top-0 h-80 w-full -translate-x-1/2 bg-[#c69b55]/15 blur-[100px] dark:bg-[#8b1725]/25"
        aria-hidden="true"
      >
      </div>

      <div class="relative mx-auto max-w-5xl text-center">
        <!-- Introducción -->
        <p
          class="mb-5 text-xs font-semibold uppercase tracking-[0.35em] text-[#955d31] dark:text-[#d6ad67] sm:text-sm"
        >
          Comparsa Los Lingotes · Carnaval 2027
        </p>

        <!-- Título -->
        <h1
          class="mx-auto max-w-4xl text-4xl font-bold leading-tight text-[#722538] dark:text-[#f3d69b] sm:text-6xl"
          style="font-family: var(--font-display);"
        >
          Bienvenidos al espectáculo
        </h1>

        <!-- Separador decorativo -->
        <div class="mx-auto my-9 flex max-w-xs items-center gap-5">
          <span class="h-px flex-1 bg-[#a67544]/60 dark:bg-[#c69b55]/60"></span>

          <span class="text-3xl text-[#955d31] dark:text-[#d6ad67]"> ✦ </span>

          <span class="h-px flex-1 bg-[#a67544]/60 dark:bg-[#c69b55]/60"></span>
        </div>

        <!-- Presentación -->
        <p
          class="mx-auto max-w-3xl text-lg leading-relaxed text-[#67453b] dark:text-[#ead6bd] sm:text-xl"
        >
          Las luces vuelven a encenderse, el telón comienza a abrirse y la magia
          del carnaval nos invita a vivir una nueva historia.
        </p>

        <p
          class="mx-auto mt-7 max-w-3xl text-base leading-relaxed text-[#67453b] dark:text-[#cdb8a3] sm:text-lg"
        >
          En 2027, la Comparsa Los Lingotes se inspira en el universo del
          <strong class="text-[#722538] dark:text-[#f3d69b]">
            Moulin Rouge
          </strong>, trasladándonos al París de la Belle Époque: una época de
          música, arte, cabaret y noches inolvidables.
        </p>

        <p
          class="mx-auto mt-7 max-w-3xl text-base leading-relaxed text-[#67453b] dark:text-[#cdb8a3] sm:text-lg"
        >
          Desde Talavera la Real, seguimos viviendo el carnaval con la ilusión,
          la pasión y el espíritu que nos acompañan en cada edición.
        </p>

        <!-- Frase destacada -->
        <div
          class="mx-auto mt-14 max-w-2xl border-y border-[#a67544]/40 px-5 py-8 dark:border-[#c69b55]/40"
        >
          <p
            class="text-xl font-semibold italic leading-relaxed text-[#722538] dark:text-[#f3d69b] sm:text-2xl"
            style="font-family: var(--font-display);"
          >
            «Que se enciendan las luces, que comience el espectáculo».
          </p>
        </div>

        <!-- Navegación -->
        <div
          class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row"
        >
          <!-- Botón Moulin Rouge -->
          <a
            href="#moulin-rouge"
            class="inline-flex min-h-12 w-full items-center justify-center rounded-full border border-[#955d31] bg-[#722538] px-8 py-3 text-sm font-bold uppercase tracking-wider text-[#fff3df] transition-colors hover:bg-[#91354a] dark:border-[#d6ad67] dark:bg-[#b88a42] dark:text-[#160508] dark:hover:bg-[#f1ce86] sm:w-auto"
          >
            Descubre el Moulin Rouge
          </a>

          <!-- Botón Historia -->
          <a
            href="/historia/"
            class="inline-flex min-h-12 w-full items-center justify-center rounded-full border border-[#955d31]/60 px-8 py-3 text-sm font-semibold uppercase tracking-wider text-[#722538] transition-colors hover:bg-[#722538]/10 dark:border-[#d6ad67]/60 dark:text-[#f3d69b] dark:hover:bg-[#d6ad67]/10 sm:w-auto"
          >
            Nuestra historia
          </a>
        </div>

        <!-- Pie decorativo -->
        <p
          class="mt-16 text-xs uppercase tracking-[0.3em] text-[#955d31] dark:text-[#c69b55]"
        >
          ✦ Talavera la Real · Badajoz ✦
        </p>
      </div>
    </section>

    <!-- CUATRO CARTELES MOULIN ROUGE -->
    <CartelesMoulinRouge />

    <!-- GALERÍA DE CARNAVALES ANTERIORES -->
    <SectionGaleria />

    <!-- REDES SOCIALES Y PIE DE PÁGINA -->
    <Footer />
  </body>
</html>
