---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import SectionGaleria from "../components/SectionGaleria.astro";
import Footer from "../components/Footer.astro";
import MusicCarnaval from "../components/MusicCarnaval.astro";
import CartelesMoulinRouge from "../components/CartelesMoulinRouge.astro";

const SITE_URL = "https://loslingotes.es";
const OG_IMAGE = `${SITE_URL}/og.jpg`;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Comparsa Los Lingotes",
  url: SITE_URL,
  logo: OG_IMAGE,
  image: OG_IMAGE,
  description:
    "Comparsa de Carnaval Los Lingotes de Talavera la Real (Badajoz). Actuaciones, historia y carnaval.",
  sameAs: [
    "https://www.facebook.com/loslingotes",
    "https://www.instagram.com/comparsalingotes",
    "https://www.tiktok.com/@comparsaloslingotes",
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Talavera la Real",
    addressRegion: "Extremadura",
    addressCountry: "ES",
  },
});
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Comparsa Los Lingotes | Talavera la Real</title>
    <meta
      name="description"
      content="Comparsa de Carnaval Los Lingotes de Talavera la Real. Actuaciones, historia y carnaval."
    />

    <link rel="canonical" href={`${SITE_URL}/`} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta name="theme-color" content="#0a0a0a" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Comparsa Los Lingotes" />
    <meta
      property="og:title"
      content="Comparsa Los Lingotes | Talavera la Real"
    />
    <meta
      property="og:description"
      content="Comparsa de Carnaval Los Lingotes de Talavera la Real. Actuaciones, galería y vídeos."
    />
    <meta property="og:url" content={`${SITE_URL}/`} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:secure_url" content={OG_IMAGE} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo Los Lingotes" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Comparsa Los Lingotes | Talavera la Real"
    />
    <meta
      name="twitter:description"
      content="Comparsa de Carnaval Los Lingotes de Talavera la Real. Actuaciones, galería y vídeos."
    />
    <meta name="twitter:image" content={OG_IMAGE} />

    <!-- SEO local: datos estructurados -->
    <script type="application/ld+json" is:inline set:html={jsonLd} />
    <!-- cpomprrobación del busacador Bing -->
    <meta name="msvalidate.01" content="2B7261B181FB3A3472FF5A58A9D5AB6D" />

    <meta name="robots" content="index,follow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Tema: evita flash -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const theme = stored ?? (prefersDark ? "dark" : "light");
        document.documentElement.classList.toggle("dark", theme === "dark");
      })();
    </script>
  </head>

  <body class="bg-amber-50 text-zinc-900 dark:bg-zinc-950 dark:text-zinc-100">
    <Header />
    <Hero />

    <!-- Carnaval (SEO + contenido visible) -->
    <section id="carnaval" class="mx-auto max-w-5xl px-4 py-16">
      <!-- MOULIN ROUGE 2027 -->
      <section
        id="carnaval"
        class="relative overflow-hidden bg-[#120609] px-5 py-20 text-[#f5dfb5] sm:py-28"
      >
        <!-- Iluminación ambiental -->
        <div
          class="pointer-events-none absolute left-1/2 top-0 h-80 w-full -translate-x-1/2 bg-[#8b1725]/25 blur-[100px]"
          aria-hidden="true"
        >
        </div>

        <div class="relative mx-auto max-w-5xl text-center">
          <!-- Introducción -->
          <p
            class="mb-5 text-xs font-semibold uppercase tracking-[0.35em] text-[#d6ad67] sm:text-sm"
          >
            Comparsa Los Lingotes · Carnaval 2027
          </p>

          <!-- Título -->
          <h2
            class="mx-auto max-w-4xl text-4xl font-bold leading-tight text-[#f3d69b] sm:text-6xl"
            style="font-family: var(--font-display);"
          >
            Bienvenidos al espectáculo
          </h2>

          <!-- Separador -->
          <div class="mx-auto my-9 flex max-w-xs items-center gap-5">
            <span class="h-px flex-1 bg-[#c69b55]/60"></span>

            <span class="text-3xl text-[#d6ad67]">✦</span>

            <span class="h-px flex-1 bg-[#c69b55]/60"></span>
          </div>

          <!-- Presentación -->
          <p
            class="mx-auto max-w-3xl text-lg leading-relaxed text-[#ead6bd] sm:text-xl"
          >
            Las luces vuelven a encenderse, el telón comienza a abrirse y la
            magia del carnaval nos invita a vivir una nueva historia.
          </p>

          <p
            class="mx-auto mt-7 max-w-3xl text-base leading-relaxed text-[#cdb8a3] sm:text-lg"
          >
            En 2027, la Comparsa Los Lingotes se inspira en el universo del <strong
              class="text-[#f3d69b]">Moulin Rouge</strong
            >, trasladándonos al París de la Belle Époque: una época de música,
            arte, cabaret y noches inolvidables.
          </p>

          <p
            class="mx-auto mt-7 max-w-3xl text-base leading-relaxed text-[#cdb8a3] sm:text-lg"
          >
            Desde Talavera la Real, seguimos viviendo el carnaval con la
            ilusión, la pasión y el espíritu que nos acompañan en cada edición.
          </p>

          <!-- Destacado -->
          <div
            class="mx-auto mt-14 max-w-2xl border-y border-[#c69b55]/40 px-5 py-8"
          >
            <p
              class="text-xl font-semibold italic leading-relaxed text-[#f3d69b] sm:text-2xl"
              style="font-family: var(--font-display);"
            >
              «Que se enciendan las luces, que comience el espectáculo».
            </p>
          </div>

          <!-- Botones -->
          <div
            class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row"
          >
            <a
              href="#moulin-rouge"
              class="inline-flex min-h-12 w-full items-center justify-center rounded-full border border-[#d6ad67] bg-[#b88a42] px-8 py-3 text-sm font-bold uppercase tracking-wider text-[#160508] transition-colors hover:bg-[#f1ce86] sm:w-auto"
            >
              Descubre el Moulin Rouge
            </a>

            <a
              href="/historia/"
              class="inline-flex min-h-12 w-full items-center justify-center rounded-full border border-[#d6ad67]/60 px-8 py-3 text-sm font-semibold uppercase tracking-wider text-[#f3d69b] transition-colors hover:bg-[#d6ad67]/10 sm:w-auto"
            >
              Nuestra historia
            </a>
          </div>

          <!-- Pie decorativo -->
          <p class="mt-16 text-xs uppercase tracking-[0.3em] text-[#c69b55]/80">
            ✦ Talavera la Real · Badajoz ✦
          </p>
        </div>
      </section>

      <!-- Header SOLO con texto (nada de divs ni componentes dentro del h2) 
      <header class="mx-auto max-w-2xl">
        <h2
          class="text-center text-2xl font-bold sm:text-3xl"
          style="font-family: var(--font-display);"
        >
          <span
            class="mx-auto mb-3 flex w-fit items-center justify-center gap-2 rounded-2xl bg-white/60 px-3 py-1 text-sm text-zinc-700 ring-1 ring-black/10 dark:bg-white/5 dark:text-zinc-200 dark:ring-white/10"
          >
            <SparkleIcon class="h-4 w-4 text-amber-600 dark:text-amber-300" />
            Carnaval &amp; Comparsa Los Lingotes
            <TrophyIcon class="h-4 w-4 text-amber-600 dark:text-amber-300" />
          </span>

          Comparsa Los Lingotes. Carnaval de Talavera la Real y Badajoz
        </h2>
      </header>

       3D fuera del h2 -->
      <div class="mt-10">
        <CartelesMoulinRouge />
      </div>

      <!-- Tarjetas -->
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        <div
          class="rounded-2xl border border-black/10 bg-white/70 p-5 shadow-sm dark:border-white/10 dark:bg-white/5"
        >
          <div class="flex items-start gap-3">
            <span
              class="grid h-10 w-10 place-items-center rounded-xl bg-amber-500/10 text-amber-700 dark:text-amber-300"
              aria-hidden="true"
            >
            </span>
            <p class="text-base text-zinc-700 dark:text-zinc-300 sm:text-lg">
              Con una trayectoria marcada por la música, el baile y la puesta en
              escena, Los Lingotes se ha consolidado como una de las comparsas
              más representativas del carnaval en la provincia de Badajoz.
            </p>
          </div>
        </div>

        <div
          class="rounded-2xl border border-black/10 bg-white/70 p-5 shadow-sm dark:border-white/10 dark:bg-white/5"
        >
          <div class="flex items-start gap-3">
            <span
              class="grid h-10 w-10 place-items-center rounded-xl bg-amber-500/10 text-amber-700 dark:text-amber-300"
              aria-hidden="true"
            >
            </span>

            <div class="text-base text-zinc-700 dark:text-zinc-300 sm:text-lg">
              <p>
                Cada edición del carnaval es una oportunidad para conectar con
                el público, llevar el espectáculo a las calles y mantener viva
                la tradición carnavalera en
                <strong> Talavera la Real</strong>.
              </p>

              <a
                href="/historia/"
                title="Historia de la comparsa Los Lingotes"
                class="mt-3 inline-flex items-center gap-2 rounded-xl border border-black/10 bg-white px-3 py-2 text-sm font-medium text-zinc-900 shadow-sm hover:bg-black/5 dark:border-white/10 dark:bg-white/5 dark:text-white dark:hover:bg-white/10"
              >
                <span aria-hidden="true">📜</span>
                Conoce nuestra historia
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Secciones fuera del header (estructura correcta) -->

    <SectionGaleria />
    <Footer />
  </body>
</html>
