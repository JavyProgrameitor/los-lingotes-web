    alt: "Los Lingotes en FITUR Madrid: foto del equipo promocionando la comparsa",
  },
  {
    src: "/events/Fitur/fitur02.png",
    alt: "Los Lingotes en FITUR Madrid: promoción y ambiente en la feria",
  },
  {
    src: "/events/Fitur/fitur03.png",
    alt: "Los Lingotes en FITUR Madrid: imagen de grupo durante la visita",
  },
  {
    src: "/events/Fitur/fitur04.png",
    alt: "Los Lingotes en FITUR Madrid: presencia de la comparsa en la feria",
  },
  {
    src: "/events/Fitur/fitur05.png",
    alt: "Los Lingotes en FITUR Madrid: presencia de la comparsa en la feria",
  },
  {
    src: "/events/Fitur/fitur06.png",
    alt: "Los Lingotes en FITUR Madrid: presencia de la comparsa en la feria",
  },
  {
    src: "/events/Fitur/fitur07.png",
    alt: "Los Lingotes en FITUR Madrid: presencia de la comparsa en la feria",
  },
  {
    src: "/events/Fitur/fitur08.png",
    alt: "Los Lingotes en FITUR Madrid: presencia de la comparsa en la feria",
  },
  {
    src: "/events/Fitur/fitur09.png",
    alt: "Los Lingotes en FITUR Madrid: presencia de la comparsa en la feria",
  },
  {
    src: "/events/Fitur/fitur10.png",
    alt: "Los Lingotes en FITUR Madrid: presencia de la comparsa en la feria",
  },
  {
    src: "/events/Fitur/fitur11.png",
    alt: "Los Lingotes en FITUR Madrid: presencia de la comparsa en la feria",
  },
  {
    src: "/events/Fitur/fitur12.png",
    alt: "Los Lingotes en FITUR Madrid: presencia de la comparsa en la feria",
  },
];

const tiktokUrl =
  "https://www.tiktok.com/@comparsaloslingotes/photo/7598938590155967767?is_from_webapp=1&sender_device=pc";
---

<section
  id="eventos"
  class="text-center mx-auto max-w-7xl px-4 py-16"
  data-events="fitur"
>
  <header class="text-center max-w-3xl">
    <h2
      class="text-2xl font-semibold sm:text-3xl"
      style="font-family: var(--font-display);"
    >
      FITUR Madrid · Los Lingotes en ruta
    </h2>

    <p class="text-center mt-3 text-zinc-700 dark:text-zinc-300">
      Visitamos <strong>FITUR (Madrid)</strong> para promocionar nuestra comparsa
      y calentar motores para el <strong>Carnaval</strong>. Aquí tienes algunas
      fotos del evento.
    </p>

    <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
      También lo publicamos en TikTok:
      <a
        href={tiktokUrl}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="underline underline-offset-4 hover:opacity-80"
      >
        Los Lingotes en FITUR Madrid
      </a>
    </p>
  </header>

  <div
    class="mt-8 rounded-2xl border border-black/10 p-4 shadow-sm dark:border-white/10 dark:bg-white/5"
  >
    <div class="flex items-center justify-between gap-3">
      <p class="text-sm text-zinc-700 dark:text-zinc-300">
        Desliza para ver todas las imagenes
      </p>

      <div class="flex gap-2">
        <button
          type="button"
          class="rounded-xl border border-black/10 bg-white px-3 py-2 text-sm font-medium hover:bg-black/5 disabled:opacity-40 dark:border-white/10 dark:bg-white/5 dark:hover:bg-white/10"
          data-prev
          aria-label="Imagen anterior"
        >
          ←
        </button>
        <button
          type="button"
          class="rounded-xl border border-black/10 bg-white px-3 py-2 text-sm font-medium hover:bg-black/5 disabled:opacity-40 dark:border-white/10 dark:bg-white/5 dark:hover:bg-white/10"
          data-next
          aria-label="Imagen siguiente"
        >
          →
        </button>
      </div>
    </div>

    <div class="mt-4 overflow-hidden">
      <ul
        class="carousel"
        data-carousel="fitur"
        aria-label="Carrusel de imágenes de Los Lingotes en FITUR Madrid"
        tabindex="0"
      >
        {
          images.map((img, i) => (
            <li
              class="slide"
              aria-label={`Imagen ${i + 1} de ${images.length}`}
            >
              <img
                src={img.src}
                alt={img.alt}
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
                class="h-full w-full rounded-2xl object-cover"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.querySelector('[data-events="fitur"]');
    if (!section) return;

    const carousel = section.querySelector('[data-carousel="fitur"]');
    const prev = section.querySelector("[data-prev]");
    const next = section.querySelector("[data-next]");
    if (!carousel || !prev || !next) return;

    const updateButtons = () => {
      const maxScrollLeft = carousel.scrollWidth - carousel.clientWidth;
      prev.disabled = carousel.scrollLeft <= 2;
      next.disabled = carousel.scrollLeft >= maxScrollLeft - 2;
    };

    const scrollByPage = (dir) => {
      const amount = carousel.clientWidth * 0.92; // “casi una página”
      carousel.scrollBy({ left: dir * amount, behavior: "smooth" });
      // Actualiza un poco después del scroll suave
      window.setTimeout(updateButtons, 250);
    };

    prev.addEventListener("click", () => scrollByPage(-1));
    next.addEventListener("click", () => scrollByPage(1));

    carousel.addEventListener("scroll", () =>
      window.requestAnimationFrame(updateButtons),
    );
    window.addEventListener("resize", () => updateButtons());

    updateButtons();
  })();
</script>

<style>
  .carousel {
    display: grid;
    grid-auto-flow: column;
    gap: 1rem;

    /* Responsive: más usable en desktop */
    grid-auto-columns: 88%;

    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 0.25rem;

    /* mejora experiencia móvil */
    -webkit-overflow-scrolling: touch;
  }

  .carousel::-webkit-scrollbar {
    height: 10px;
  }

  .slide {
    scroll-snap-align: start;
    aspect-ratio: 4 / 5; /* mantiene altura estable aunque no haya width/height */
  }

  @media (min-width: 640px) {
    .carousel {
      grid-auto-columns: 60%;
    }
  }

  @media (min-width: 1024px) {
    .carousel {
      grid-auto-columns: 38%;
    }
  }

  @media (min-width: 1280px) {
    .carousel {
      grid-auto-columns: 30%;
    }
  }
</style>
