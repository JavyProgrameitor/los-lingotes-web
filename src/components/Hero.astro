---
const heroImage = "moulin-rouge-2027.png";
const heroVideo = "/video/moulin-rouge.mp4";
---

<section id="inicio" class="moulin-hero">
  <!-- Fondo desenfocado para PC -->
  <div
    class="hero-background"
    style={`background-image: url('${heroImage}')`}
    aria-hidden="true"
  >
  </div>

  <!-- Oscurecimiento lateral -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <!-- Vídeo principal: sin modificaciones -->
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={heroImage}
    aria-label="Animación Moulin Rouge de Los Lingotes 2027"
  >
    <source src={heroVideo} type="video/mp4" />
  </video>
</section>

<style>
  /* CONTENEDOR PRINCIPAL */
  .moulin-hero {
    position: relative;
    width: 100%;
    height: 100svh;
    overflow: hidden;

    /* Modo claro */
    background: #f5e9d7;

    display: flex;
    align-items: center;
    justify-content: center;
    isolation: isolate;

    transition: background-color 0.5s ease;
  }

  /* Modo oscuro */
  :global(.dark) .moulin-hero {
    background: #120407;
  }

  /* FONDO CINEMATOGRÁFICO */
  .hero-background {
    position: absolute;
    inset: -30px;
    background-position: center;
    background-size: cover;

    /* Modo claro: fondo desenfocado más luminoso */
    filter: blur(35px) brightness(0.9);

    transform: scale(1.1);
    z-index: -2;

    transition: filter 0.5s ease;
  }

  /* Modo oscuro: iluminación original */
  :global(.dark) .hero-background {
    filter: blur(35px) brightness(0.45);
  }

  /* CAPA LATERAL */
  .hero-overlay {
    position: absolute;
    inset: 0;

    /* Modo claro */
    background: linear-gradient(
      90deg,
      rgba(245, 233, 215, 0.75),
      transparent 35%,
      transparent 65%,
      rgba(245, 233, 215, 0.75)
    );

    z-index: -1;

    transition: background 0.5s ease;
  }

  /* Modo oscuro: degradado original */
  :global(.dark) .hero-overlay {
    background: linear-gradient(
      90deg,
      rgba(15, 2, 5, 0.55),
      transparent 35%,
      transparent 65%,
      rgba(15, 2, 5, 0.55)
    );
  }

  /* VÍDEO PRINCIPAL: CONFIGURACIÓN ORIGINAL */
  .hero-video {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
    z-index: 1;
  }

  /* MÓVILES: CONSERVAMOS EL ENCUADRE ORIGINAL */
  @media (max-width: 767px) {
    .hero-background,
    .hero-overlay {
      display: none;
    }

    .hero-video {
      object-fit: cover;
      transform: scale(0.9);
    }
  }

  /* ACCESIBILIDAD */
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }

    .hero-background {
      inset: 0;
      filter: none;
      transform: none;
      background-size: contain;
      background-repeat: no-repeat;
    }
  }
</style>
