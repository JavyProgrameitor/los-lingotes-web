---
const heroImage = "moulin-rouge-2027.png";
const heroVideo = "/video/moulin-rouge.mp4";
---

<section id="inicio" class="moulin-hero">
  <!-- Fondo desenfocado para PC -->
  <div
    class="hero-background"
    style={`background-image: url('${heroImage}')`}
    aria-hidden="true"
  >
  </div>

  <!-- Oscurecimiento -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <!-- Vídeo principal -->
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={heroImage}
    aria-label="Animación Moulin Rouge de Los Lingotes 2027"
  >
    <source src={heroVideo} type="video/mp4" />
  </video>
</section>

<style>
  .moulin-hero {
    position: relative;
    width: 100%;
    height: 100svh;
    overflow: hidden;
    background: #120407;
    display: flex;
    align-items: center;
    justify-content: center;
    isolation: isolate;
  }

  /* Fondo cinematográfico */
  .hero-background {
    position: absolute;
    inset: -30px;
    background-position: center;
    background-size: cover;
    filter: blur(35px) brightness(0.45);
    transform: scale(1.1);
    z-index: -2;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(15, 2, 5, 0.55),
      transparent 35%,
      transparent 65%,
      rgba(15, 2, 5, 0.55)
    );
    z-index: -1;
  }

  /* Vídeo principal */
  .hero-video {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
    z-index: 1;
  }

  /* MÓVILES */
  @media (max-width: 767px) {
    .hero-background,
    .hero-overlay {
      display: none;
    }

    .hero-video {
      object-fit: cover;
      transform: scale(0.9);
    }
  }

  /* Accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }

    .hero-background {
      inset: 0;
      filter: none;
      transform: none;
      background-size: contain;
      background-repeat: no-repeat;
    }
  }
</style>
