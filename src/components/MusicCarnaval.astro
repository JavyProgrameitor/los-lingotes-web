---
const audioSrc = "/audio/samba-latino.mp3";
---

<div class="fixed bottom-4 right-4 z-50">
  <button
    id="music-toggle"
    class="flex items-center gap-2 rounded-full bg-black/80 px-4 py-3 text-sm font-semibold text-white shadow-lg backdrop-blur hover:bg-black"
    aria-label="Activar o pausar música de carnaval"
  >
    ▶️ Carnaval
  </button>

  <audio id="carnaval-audio" src={audioSrc} loop preload="none"></audio>
</div>

<script is:inline>
  (() => {
    const btn = document.getElementById("music-toggle");
    const audio = document.getElementById("carnaval-audio");
    if (!btn || !audio) return;

    let playing = false;

    btn.addEventListener("click", () => {
      if (!playing) {
        audio.play();
        btn.textContent = "⏸️ Carnaval";
      } else {
        audio.pause();
        btn.textContent = "▶️ Carnaval";
      }
      playing = !playing;
    });
  })();
</script>
