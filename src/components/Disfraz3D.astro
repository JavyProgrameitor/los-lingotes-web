---
/**
 * Bloque elegante con imagen “cinematográfica”
 * - Entrada suave al hacer scroll
 * - Parallax muy sutil (ratón + táctil)
 * - Fondo desenfocado para profundidad
 *
 * Requisito:
 * - /public/models/todas.jpeg
 */
---

<section class="wrap reveal" data-reveal>
  <div class="card">
    <h2 class="title" style="font-family: var(--font-display);">
      Nuestro agradecimiento por creer en la magia del carnaval y por
      permitirnos compartir esta experiencia única con todos vosotros.🎉
    </h2>

    <figure class="cinema" data-parallax>
      <!-- Fondo desenfocado -->
      <img
        class="bg"
        src="/models/todas.jpeg"
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />

      <!-- Imagen principal -->
      <img
        class="fg"
        src="/models/todas.jpeg"
        alt="Disfraz de carnaval de Los Lingotes"
        loading="lazy"
        decoding="async"
      />

      <div class="vignette" aria-hidden="true"></div>
    </figure>
  </div>
</section>

<script is:inline>
  // === 1) Animación de entrada al hacer scroll (suave) ===
  const revealEls = document.querySelectorAll("[data-reveal]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!reduced && revealEls.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-visible");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.18, rootMargin: "0px 0px -10% 0px" },
    );

    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add("is-visible"));
  }

  // === 2) Parallax MUY suave (ratón + táctil) ===
  const p = document.querySelector("[data-parallax]");
  if (p && !reduced) {
    let tx = 0,
      ty = 0,
      cx = 0,
      cy = 0;

    const setTarget = (clientX, clientY) => {
      const r = p.getBoundingClientRect();
      const x = (clientX - r.left) / r.width; // 0..1
      const y = (clientY - r.top) / r.height; // 0..1
      tx = (x - 0.5) * 10; // intensidad en px (suave)
      ty = (y - 0.5) * 10;
    };

    p.addEventListener("mousemove", (e) => setTarget(e.clientX, e.clientY), {
      passive: true,
    });
    p.addEventListener(
      "touchmove",
      (e) => {
        if (e.touches && e.touches[0])
          setTarget(e.touches[0].clientX, e.touches[0].clientY);
      },
      { passive: true },
    );

    const tick = () => {
      cx += (tx - cx) * 0.08;
      cy += (ty - cy) * 0.08;
      p.style.setProperty("--px", cx.toFixed(2) + "px");
      p.style.setProperty("--py", cy.toFixed(2) + "px");
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>

<style>
  /* Contenedor */
  .wrap {
    margin: 0 auto;
    width: 100%;
    max-width: 64rem; /* max-w-5xl aprox */
    padding: 3rem 1rem; /* py-12 + px-4 */
  }

  .card {
    border-radius: 1rem;
    border: 1px solid rgba(0, 0, 0, 0.1);
    background: rgba(255, 255, 255, 0.7);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  :global(.dark) .card {
    border-color: rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .title {
    text-align: center;
    font-weight: 700;
    font-size: clamp(1.2rem, 2.4vw, 1.8rem);
    margin: 0.75rem 1rem 1rem;
    line-height: 1.25;
  }

  /* Bloque imagen “cinema” */
  .cinema {
    --px: 0px;
    --py: 0px;

    position: relative;
    width: 100%;
    height: min(70vh, 520px);
    overflow: hidden;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  :global(.dark) .cinema {
    border-top-color: rgba(255, 255, 255, 0.1);
  }

  .cinema img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cinema .bg {
    filter: blur(18px) saturate(1.05);
    transform: scale(1.18)
      translate3d(calc(var(--px) * -0.35), calc(var(--py) * -0.35), 0);
    opacity: 0.95;
  }

  .cinema .fg {
    transform: scale(1.03)
      translate3d(calc(var(--px) * 0.55), calc(var(--py) * 0.55), 0);
    animation: kenburns 18s ease-in-out infinite alternate;
    will-change: transform;
  }

  .cinema .vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        60% 55% at 50% 35%,
        rgba(255, 255, 255, 0.1),
        rgba(0, 0, 0, 0.12) 70%
      ),
      radial-gradient(
        120% 90% at 50% 50%,
        transparent 50%,
        rgba(0, 0, 0, 0.28) 100%
      );
    pointer-events: none;
  }

  @keyframes kenburns {
    from {
      transform: scale(1.03)
        translate3d(calc(var(--px) * 0.55), calc(var(--py) * 0.55), 0);
    }
    to {
      transform: scale(1.08)
        translate3d(calc(var(--px) * 0.55), calc(var(--py) * 0.55), 0);
    }
  }

  /* Entrada suave al hacer scroll */
  .reveal {
    opacity: 0;
    transform: translateY(18px) scale(0.995);
    transition:
      opacity 700ms ease,
      transform 800ms cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: opacity, transform;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* Accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .cinema .fg {
      animation: none !important;
    }
  }
</style>
